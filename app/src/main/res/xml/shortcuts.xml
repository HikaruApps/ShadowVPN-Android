<?xml version="1.0" encoding="utf-8"?>
<!-- Long press on the launcher icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="connect" android:enabled="true"
        android:icon="@drawable/ic_shortcut_connect"
        android:shortcutShortLabel="@string/shortcut_connect"
        android:shortcutLongLabel="@string/shortcut_connect_long">
        <intent android:action="net.shadownet.shadowvpn.action.CONNECT"
            android:targetPackage="net.shadownet.shadowvpn.android"
            android:targetClass="net.shadownet.shadowvpn.android.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="disconnect" android:enabled="true"
        android:icon="@drawable/ic_shortcut_disconnect"
        android:shortcutShortLabel="@string/shortcut_disconnect"
        android:shortcutLongLabel="@string/shortcut_disconnect_long">
        <intent android:action="net.shadownet.shadowvpn.action.DISCONNECT"
            android:targetPackage="net.shadownet.shadowvpn.android"
            android:targetClass="net.shadownet.shadowvpn.android.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="servers" android:enabled="true"
        android:icon="@drawable/ic_shortcut_servers"
        android:shortcutShortLabel="@string/shortcut_servers"
        android:shortcutLongLabel="@string/shortcut_servers_long">
        <intent android:action="net.shadownet.shadowvpn.action.SERVERS"
            android:targetPackage="net.shadownet.shadowvpn.android"
            android:targetClass="net.shadownet.shadowvpn.android.MainActivity" />
    </shortcut>
</shortcuts>
